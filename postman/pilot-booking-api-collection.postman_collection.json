            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ✅ Save accessToken from nested JSON response\r",
                  "let response = pm.response.json();\r",
                  "\r",
                  "if (response?.data?.accessToken) {\r",
                  "    pm.collectionVariables.set(\"token\", response.data.accessToken);\r",
                  "    console.log(\"✅ Access Token stored in collection variables\");\r",
                  "} else {\r",
                  "    console.warn(\"⚠️ Access Token not found in response\");\r",
